# Copy to .env.local for local overrides (gitignored). In production this
# repo sets these as Docker build args (see deploy/Dockerfile.prod and
# .github/workflows/docker-build.yml) rather than a committed .env file.

# "development" or "production". Production is the only mode that allows
# indexing and analytics.
VITE_PUBLIC_ENV=development

# Set to "true" only for the public production build. Everything else
# (local dev, previews) should stay non-indexable.
VITE_INDEXABLE=false

# Canonical URL used for <link rel="canonical">, Open Graph og:url, and
# JSON-LD. Should match the public deployment URL in production.
VITE_CANONICAL_URL=http://localhost:5174

# Analytics is production-only and disabled by default. The script only
# loads when ALL of these hold: VITE_ANALYTICS_ENABLED=true,
# VITE_ANALYTICS_SRC is set, VITE_ANALYTICS_WEBSITE_ID is set, and
# VITE_PUBLIC_ENV=production.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_SRC=https://analytics.example.com/fetch.js
VITE_ANALYTICS_WEBSITE_ID=

# Surfaced subtly in the footer. Falls back to package.json's version field
# when unset.
VITE_APP_VERSION=
